    }

    body {
      font-family: Arial, sans-serif;
      background: #0b0b0f;
      color: #f5f5f5;
      line-height: 1.7;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 22px 8%;
      border-bottom: 1px solid #25252d;
      position: sticky;
      top: 0;
      background: #0b0b0f;
      z-index: 10;
    }

    .logo {
      font-size: 25px;
      font-weight: bold;
    }

    nav {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }

    nav a {
      color: #b6b6c2;
      font-size: 14px;
    }

    nav a:hover {
      color: #9b8cff;
    }

    section {
      padding: 85px 8%;
    }

    .hero {
      min-height: 80vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
    }

    .tag {
      color: #a99bff;
      letter-spacing: 3px;
      font-size: 13px;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(42px, 8vw, 78px);
      line-height: 1.15;
      margin: 15px 0;
    }

    h1 span {
      color: #a99bff;
    }

    h2 {
      font-size: 35px;
      margin-bottom: 12px;
    }

    .subtitle {
      color: #b6b6c2;
      max-width: 650px;
      margin-bottom: 25px;
    }

    .btn {
      display: inline-block;
      background: #a99bff;
      color: #111;
      padding: 12px 22px;
      border-radius: 8px;
      font-weight: bold;
      margin: 8px 8px 8px 0;
    }

    .btn:hover {
      background: #c0b6ff;
    }

    .outline {
      background: transparent;
      border: 1px solid #555568;
      color: white;
    }

    .muted {
      color: #aaaab8;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-top: 30px;
    }

    .card {
      background: #14141b;
      border: 1px solid #292934;
      padding: 25px;
      border-radius: 14px;
      transition: transform 0.2s, border-color 0.2s;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: #a99bff;
    }

    .card h3 {
      margin-bottom: 12px;
      color: #c0b6ff;
    }

    .stats {
      display: flex;
      flex-wrap: wrap;
      gap: 35px;
      margin-top: 30px;
    }

    .stats strong {
      display: block;
      font-size: 28px;
      color: #a99bff;
    }

    .skills span {
      display: inline-block;
      background: #22222d;
      border: 1px solid #383846;
      border-radius: 7px;
      padding: 8px 13px;
      margin: 5px;
      font-size: 14px;
    }

    .timeline {
      border-left: 2px solid #a99bff;
      padding-left: 25px;
      margin-top: 30px;
    }

    .job {
      margin-bottom: 30px;
    }

    .job h3 {
      color: #c0b6ff;
    }

    .contact {
      text-align: center;
    }

    footer {
      text-align: center;
      padding: 25px;
      border-top: 1px solid #25252d;
      color: #9999a8;
      font-size: 14px;
    }

    @media (max-width: 650px) {
      header {
        align-items: flex-start;
        flex-direction: column;
        gap: 12px;
      }

      nav {
        gap: 12px;
      }

      section {
        padding: 60px 6%;
      }

      h2 {
        font-size: 29px;
      }
    }
  </style>
</head>

